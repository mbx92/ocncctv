# Salin ke Coolify → Environment Variables (Docker Compose).
# App saja — Postgres & MinIO sudah jalan di server terpisah.
# Jangan commit nilai asli ke git.
#
# Hostname Coolify (UUID seperti m2a81yq3ad7hvelheztfqywy) hanya
# resolve jika app dan Postgres/MinIO di jaringan Docker yang sama.
# Di resource app Coolify: General → Connect to Predefined Network → on,
# lalu redeploy. Atau di Postgres: Networks → sambungkan ke jaringan app.
# Karakter khusus di password DATABASE_URL harus di-URL-encode
# (@ → %40, # → %23, / → %2F).

# --- Wajib ---
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/ocn

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=

MINIO_ENDPOINT=minio.internal
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=ocn-files

# Katalog supplier (Google Sheets publik, same source PaymentSystemOCN)
# SUPPLIER_CATALOG_SPREADSHEET_ID=1aaKkgM9NVRsdKTFhqE46lvyLZ4rsLtxcq3_ninX6ncg
# SUPPLIER_CATALOG_SUPPLIER_NAME=PL TUNAS JAYA ELEKTRONIK

# Contoh MinIO publik di belakang HTTPS (Coolify / Cloudflare):
# MINIO_ENDPOINT=s3.example.com
# MINIO_PORT=443
# MINIO_USE_SSL=true
# Jangan isi https:// di MINIO_ENDPOINT — cukup hostname.
# Port 9000 biasanya hanya untuk akses internal Docker, bukan domain publik HTTPS.
